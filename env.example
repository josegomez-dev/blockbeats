# ===========================================
# BLOCKBEATS ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# ===========================================
# FIREBASE CONFIGURATION (REQUIRED)
# ===========================================
# Get these values from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=xxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxx
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxx
NEXT_PUBLIC_FIREBASE_APP_ID=1:xxx

# ===========================================
# ANALYTICS CONFIGURATION (OPTIONAL)
# ===========================================
# Analytics Measurement ID (from Firebase Console > Analytics or Google Analytics)
# This single ID serves both Firebase Analytics and Google Analytics
NEXT_PUBLIC_ANALYTICS_MEASUREMENT_ID=

# ===========================================
# NFT MINTING CONFIGURATION (OPTIONAL)
# ===========================================
# Pinata IPFS Configuration - Get these from https://pinata.cloud/
# 1. Go to pinata.cloud and sign up/login
# 2. Navigate to API Keys section
# 3. Create a new API key
# 4. Copy both the API Key and Secret API Key
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key_here
NEXT_PUBLIC_PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here
NEXT_PUBLIC_PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Starknet NFT Contract Configuration - Set after deploying your contract
# Deploy using: python scripts/deploy_contract.py (deploys to mainnet)
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x...

# Starknet Wallet Credentials (for contract deployment)
# Get these from your Starknet wallet (ArgentX, Braavos, etc.)
STARKNET_PRIVATE_KEY=0x...
STARKNET_ACCOUNT_ADDRESS=0x...

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Set to false for production
BLOCKBEATS_DEVELOPMENT_MODE=true

# ===========================================
# DEPLOYMENT NOTES
# ===========================================
# For Vercel deployment:
# 1. Go to Vercel Dashboard > Your Project > Settings > Environment Variables
# 2. Add each variable above with your actual values
# 3. Set BLOCKBEATS_DEVELOPMENT_MODE=false for production
# 4. Redeploy your application
